# ==============================================================================
# HOTEL CENTRAL - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env ou adicione estas variáveis no painel do Netlify:
# Netlify > Site configuration > Environment variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUÇÃO (NETLIFY + SUPABASE)
# ------------------------------------------------------------------------------
# Obtenha no Supabase: Project Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres.[SEU_PROJETO]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Chave secreta para tokens JWT (Gere uma chave longa e segura)
JWT_SECRET="hotel_central_jwt_secret_2026_super_seguro"

# Ambiente de execução
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. DESENVOLVIMENTO LOCAL (SQLITE) - Opcional se for rodar local no PC
# ------------------------------------------------------------------------------
# DATABASE_URL="file:./prisma/hotel.db"
# JWT_SECRET="hotel_central_jwt_secret_local"
# PORT=3001
# NODE_ENV="development"

