# URL de conexão com o banco de dados
# Para Supabase (PostgreSQL na nuvem):
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Para SQLite local (desenvolvimento no computador):
# DATABASE_URL="file:./prisma/hotel.db"

# Chave secreta de autenticação JWT (gere uma chave longa e aleatória)
# Exemplo: openssl rand -base64 32
JWT_SECRET="COLOQUE_UMA_CHAVE_SECRETA_ALEATORIA_AQUI"

# Porta do servidor local
PORT=3001

# Ambiente: development ou production
NODE_ENV=development
